# --- App Settings ---
APP_NAME="Resyntra Backend"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="your-super-secret-change-me-in-production-key"

# --- Database Settings (PostgreSQL) ---
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="your_secure_password"
DB_NAME="resyntra_db"

# --- SQLAlchemy Connection String ---
# SQLAlchemy 2.0 requires 'postgresql+psycopg' or 'postgresql+asyncpg' (for async)
DATABASE_URL="postgresql+psycopg://postgres:your_secure_password@localhost:5432/resyntra_db"
